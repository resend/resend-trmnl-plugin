<script src="https://trmnl.com/js/highcharts/12.3.0/highcharts.js"></script>
<script src="https://trmnl.com/js/highcharts/12.3.0/pattern-fill.js"></script>

{% if error %}
{% render "error_state", error: error, range_label: range_label, resend_logo: resend_logo %}
{% else %}
<div class="layout layout--col layout--top gap--medium">
  <div class="flex flex--col flex--left flex--top w--full">
    <span class="label">EMAILS</span>
    <span class="value value--large value--tnums">{{ emails | number_with_delimiter }}</span>
  </div>
  <div class="flex flex--col flex--left flex--top w--full">
    <span class="label">DELIVERABILITY</span>
    <span class="value value--large value--tnums">{{ deliverability_rate }}</span>
  </div>

  {% assign chart_id = "chart" | append_random %}
  <div id="{{ chart_id }}" class="w--full"></div>

  <div class="flex flex--row flex--left flex--top gap--xlarge w--full">
    <div class="flex flex--col flex--left flex--top">
      <span class="label label--small">BOUNCES</span>
      <span class="value value--small value--tnums">{{ bounce_rate }}</span>
    </div>
    <div class="flex flex--col flex--left flex--top">
      <span class="label label--small">COMPLAINTS</span>
      <span class="value value--small value--tnums">{{ complaint_rate }}</span>
    </div>
  </div>
</div>

{% render "title_bar", range_label: range_label, resend_logo: resend_logo %}
{% render "area_chart", chart_id: chart_id, days: days, sent: sent, height: 110, axes: false %}
{% endif %}
