<div class="layout layout--col layout--center-y gap--medium">
  <div class="flex flex--col flex--left flex--top w--full">
    <span class="label label--small">EMAILS</span>
    <span class="value value--tnums">{{ emails | number_with_delimiter }}</span>
  </div>
  <div class="flex flex--col flex--left flex--top w--full">
    <span class="label label--small">DELIVERABILITY</span>
    <span class="value value--tnums">{{ deliverability_rate }}%</span>
  </div>
</div>

{% render "title_bar", range_label: range_label, resend_logo: resend_logo %}
