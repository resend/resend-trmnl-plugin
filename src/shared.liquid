{% template title_bar %}
<div class="title_bar">
  <img class="image image--adaptive" src="data:image/svg+xml;base64,{{ resend_logo | base64_encode }}" alt="Resend">
  <span class="title">Resend</span>
  <span class="instance">{{ range_label }}</span>
</div>
{% endtemplate %}

{% template error_state %}
<div class="layout layout--col layout--center gap--small">
  <span class="label">COULDN'T LOAD METRICS</span>
  <span class="description" data-clamp="3">{{ error }}</span>
</div>
<div class="title_bar">
  <img class="image image--adaptive" src="data:image/svg+xml;base64,{{ resend_logo | base64_encode }}" alt="Resend">
  <span class="title">Resend</span>
  <span class="instance">{{ range_label }}</span>
</div>
{% endtemplate %}

{% comment %}
  Area chart of emails per day. Params: chart_id (use append_random), days, sent,
  axes (false hides both axes for small views). The chart fills its container,
  so give the container the space it should take (e.g. `grow`).
{% endcomment %}
{% template area_chart %}
<script>
  (function () {
    function whenReady(cb) {
      var tries = 0;
      (function attempt() {
        if (window.TRMNLCharts && window.Highcharts) return cb();
        if (++tries > 200) return;
        setTimeout(attempt, 50);
      })();
    }

    whenReady(function () {
      var el = "{{ chart_id }}";
      var days = {{ days | json }};
      var sent = {{ sent | json }};
      var axes = {{ axes | json }};

      TRMNLCharts.watch(el, function () {
        var fill = TRMNLCharts.paint("gray-60", { el: el });
        var chart = Highcharts.chart(el, TRMNLCharts.merge(TRMNLCharts.options({ el: el }), {
          chart: { type: "area", animation: false, height: null },
          xAxis: { visible: axes, categories: days, tickInterval: 2, gridLineWidth: 0 },
          yAxis: {
            visible: axes,
            opposite: true,
            min: 0,
            tickAmount: 5,
            gridLineWidth: 0,
            title: { text: null },
            labels: {
              formatter: function () { return this.value >= 1000 ? (this.value / 1000) + "k" : this.value; }
            }
          },
          plotOptions: {
            series: { animation: false, lineWidth: TRMNLPaint.px(4, { el: el }) }
          },
          series: [{
            name: "Emails",
            data: sent,
            color: TRMNLCharts.series(0, 1, { el: el }),
            fillColor: fill,
            fillOpacity: 1
          }]
        }));
        return chart;
      });
    });
  })();
</script>
{% endtemplate %}
